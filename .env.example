# Postgres (fourni tel quel en local via docker-compose ; en prod, ressource Coolify separee)
DATABASE_URL=postgresql+psycopg://ebay_analytics:ebay_analytics@db:5432/ebay_analytics

# App eBay Developer (developer.ebay.com > My Account > Application Keys)
EBAY_ENV=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# RuName (redirect URI configure cote eBay Developer, pas une vraie URL)
EBAY_RU_NAME=
# URL HTTPS publique du callback OAuth, exposee sur le domaine Coolify
EBAY_OAUTH_REDIRECT_URI=https://your-app.example.com/oauth/callback

# Trading API (token utilisateur "traditionnel" - meme token OAuth2 fonctionne via header X-EBAY-API-IAF-TOKEN)
EBAY_TRADING_SITE_ID=71
# Compat-level Trading API
EBAY_TRADING_COMPATIBILITY_LEVEL=1413

# Marketplace pour Analytics/Fulfillment
EBAY_MARKETPLACE_ID=EBAY_FR

# Protege /oauth/login - au moins 16 caracteres aleatoires
ADMIN_PASSWORD=

# Alerting (phase 1: log uniquement, canal reel branche plus tard)
ALERTING_BACKEND=log

# Timezone metier
APP_TIMEZONE=Europe/Paris

LOG_LEVEL=INFO
